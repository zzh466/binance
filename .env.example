# 默认必须先使用 Spot Testnet。
BINANCE_TESTNET=true

# 推荐分别配置两个环境的凭证，页面顶部切换环境时会自动选择对应凭证。
# 行情订阅不需要 API Key；账户查询、下单和撤单需要目标环境的 Key。
BINANCE_TESTNET_API_KEY=你的_Testnet_API_Key
BINANCE_TESTNET_API_SECRET=你的_Testnet_API_Secret
BINANCE_PRODUCTION_API_KEY=你的_正式环境_API_Key
BINANCE_PRODUCTION_API_SECRET=你的_正式环境_API_Secret

# 兼容旧配置：以下通用凭证仅用于 BINANCE_TESTNET 指定的启动默认环境。
# BINANCE_API_KEY=你的当前默认环境_API_Key
# BINANCE_API_SECRET=你的当前默认环境_API_Secret

# 为降低报单延迟，默认不在每笔报单前额外查询账户余额；
# Binance 撮合引擎仍会原子校验余额。需要本地余额预查时改为 true。
BINANCE_PREFLIGHT_BALANCE_CHECK=false
# 默认必须先使用 Binance Spot Testnet。
# 增量深度推送频率：100ms 或 1000ms。
BINANCE_DEPTH_SPEED=100ms

# REST 深度快照档数：100、500、1000 或 5000。
# 本示例默认维护 1000 档；设置为 5000 可扩大初始覆盖范围，但请求权重更高。
BINANCE_DEPTH_SNAPSHOT_LIMIT=1000

# 每次发送给渲染进程并显示的买卖盘档数。
BINANCE_DEPTH_DISPLAY_LEVELS=5
