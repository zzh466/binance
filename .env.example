# 默认使用 Binance 正式环境；如需测试环境，请改为 true。
BINANCE_TESTNET=false

# 仅配置 USDⓈ-M Futures。行情订阅不需要 API Key；账户查询、下单和撤单需要凭证。
# Futures Testnet 需要在 Futures Demo 单独申请凭证。
BINANCE_TESTNET_FUTURES_API_KEY=你的_Futures_Testnet_API_Key
BINANCE_TESTNET_FUTURES_API_SECRET=你的_Futures_Testnet_API_Secret
BINANCE_PRODUCTION_FUTURES_API_KEY=你的_Futures_正式环境_API_Key
BINANCE_PRODUCTION_FUTURES_API_SECRET=你的_Futures_正式环境_API_Secret

# U 本位 Link 经纪商 Code。登录成功后优先使用管理端系统配置返回值。
# 普通报单会生成：x-{LinkID}-{唯一订单编号}
BINANCE_FUTURES_LINK_ID=tdk3UjFd

# 可选：填写 Binance 为同一批子账号配置的 tradeGroupId。
# 程序启动后会读取当前 API Key 所属账户并提示是否一致；-1 只保护账号内部。
# BINANCE_FUTURES_EXPECTED_TRADE_GROUP_ID=你的U本位交易组ID

# 为降低报单延迟，默认不在每笔报单前额外查询账户余额；
# Binance 撮合引擎仍会原子校验余额。需要本地余额预查时改为 true。
BINANCE_PREFLIGHT_BALANCE_CHECK=false
# 可选：Electron 与 Node 原生网络都不可用、需要启用 curl 后备时指定完整路径。
# Windows 示例：BINANCE_CURL_PATH=C:\Windows\System32\curl.exe
# macOS 通常无需配置，默认使用 /usr/bin/curl。
# BINANCE_CURL_PATH=
# 增量深度推送频率：100ms 或 1000ms。
BINANCE_DEPTH_SPEED=100ms

# 页面可切换 Binance 5/10/20 档部分深度流，默认 20 档；不下载或维护 1000 档 REST 快照。
