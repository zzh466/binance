# 默认必须先使用 Spot Testnet。
BINANCE_TESTNET=true

# 所有 Binance REST 和 WebSocket 请求统一通过此 SOCKS5 隧道。
# socks5h 表示由代理解析 Binance 域名；格式：socks5h://主机:端口
BINANCE_SOCKS5_PROXY=socks5h://139.224.34.110:1080

# 行情订阅不需要 API Key；下单、撤单需要 Testnet API Key。
BINANCE_API_KEY=EU1CLiJ4sEHQSYX8nT4QBtDRs2etO9mfcqMy2mXekOtxliLcNK5hby4aceHXAgfL
BINANCE_API_SECRET=lRmMCtYDXVkHDstvgJRC3rLRsXh3dOX5bd4AB8oqGoJXPvT7eX4kA72Kab4OqDjO
# 默认必须先使用 Binance Spot Testnet。
# 增量深度推送频率：100ms 或 1000ms。
BINANCE_DEPTH_SPEED=100ms

# REST 深度快照档数：100、500、1000 或 5000。
# 本示例默认维护 1000 档；设置为 5000 可扩大初始覆盖范围，但请求权重更高。
BINANCE_DEPTH_SNAPSHOT_LIMIT=1000

# 每次发送给渲染进程并显示的买卖盘档数。
BINANCE_DEPTH_DISPLAY_LEVELS=5
